# ── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Icon?

# ── Node ───────────────────────────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
dist/
build/
coverage/
*.tsbuildinfo

# ── Środowisko ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Stan runtime demona ────────────────────────────────────────────────────
# Lease'y, gniazdo, PID i logi demona są stanem jednej maszyny, nie kodem.
.rover/
*.sock
*.pid

# ── Materiał TLS ───────────────────────────────────────────────────────────
# Certyfikat i klucz hosta sieciowego to sekret jednej maszyny, nie kod.
# Wygenerowany w katalogu repozytorium nie może trafić do commita przez pomyłkę.
*.pem
*.key

# ── Artefakty przebiegów ───────────────────────────────────────────────────
# Zrzuty ekranu, nagrania, zrzuty hierarchii — dowody z konkretnego przebiegu,
# nie źródło. Trzymane poza repo, żeby historia nie puchła od PNG-ów.
artifacts/
*.mp4

# Wyjątek: nagrania w tests/fixtures/adb/ nie są artefaktami przebiegu, tylko
# fixture'ami parsera — pinują `isFinishedRecording` (record_video, R14).
# Sedno tkwi w tym, że nagranie skończone i nagranie wyciągnięte w trakcie zapisu
# różnią się wyłącznie obecnością atomu `moov`, więc ręcznie napisany plik
# udowodniłby dokładnie to, czego dowieść nie może (tests/fixtures/adb/README.md).
# Razem ~67 KB i nigdy się nie zmienią — historia od tego nie spuchnie.
!tests/fixtures/adb/*.mp4

# ── Edytory ────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
